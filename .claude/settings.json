{
  "permissions": {
    "allow": [
      "Write",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(gh issue *)",
      "Bash(gh pr create)",
      "Bash(gh pr checks)",
      "Bash(pwd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(diff *)",
      "Bash(grep *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Bash(git merge)",
      "Bash(git rebase)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git config --global*)",
      "Bash(pass-cli *)",
      "Write(.env.local)",
      "Bash(gh pr merge)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/fixed-proof-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/post-write-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/on-stop-nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/idea-detection-nudge.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/review-dispatch-nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
